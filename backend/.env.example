APP_NAME=AI Product Demand Analyzer API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/ai_product_demand_analyzer
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=26214400

# Local Ollama (enable after installing qwen3:4b and starting the server).
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3:4b
AI_API_KEY=ollama
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=512
AI_TEMPERATURE=0.2
AI_MAX_CONTEXT_RECORDS=100
AI_MAX_HISTORY_MESSAGES=10
# Verified non-thinking transport; openai selects AsyncOpenAI compatibility mode.
AI_OLLAMA_TRANSPORT=native
AI_CONTEXT_CHAR_LIMIT=8000
AI_NUM_CTX=8192
AI_MAX_RETRIEVAL_SERIES=1000
AI_MAX_CONCURRENT_REQUESTS=1
AI_CONVERSATION_TTL_SECONDS=1800
AI_MAX_CONVERSATIONS=128

# Optional authenticated local development (Angular: ng serve --configuration authentication)
AUTH_ENABLED=false
JWT_SIGNING_SECRET=
JWT_ISSUER=ai-product-demand-analyzer
JWT_AUDIENCE=demand-analyzer-browser
AUTH_ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_LOGIN_REQUESTS_PER_MINUTE=10
