# Install manually as /etc/demand/runtime.env, root:root 0600. Never upload to Terraform.
# These are deployment placeholders, not generated credentials.
POSTGRES_PASSWORD=REPLACE-owner-password
APP_DB_PASSWORD=REPLACE-app-password
DATABASE_URL=postgresql+psycopg://demand_app:REPLACE-URL-ENCODED-app-password@db:5432/demand
MIGRATION_DATABASE_URL=postgresql+psycopg://demand_owner:REPLACE-URL-ENCODED-owner-password@db:5432/demand
JWT_SIGNING_SECRET=REPLACE-with-at-least-64-cryptographically-random-characters
AUTH_ALLOWED_ORIGINS=["https://REPLACE-domain"]
TRUSTED_HOSTS=["REPLACE-domain","localhost","127.0.0.1"]
