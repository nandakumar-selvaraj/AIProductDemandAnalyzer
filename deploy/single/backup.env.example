# Root-owned /etc/demand/backup.env, mode 0600. Dedicated off-server SFTP account.
RESTIC_REPOSITORY=sftp:demand-backup:/demand-repository
RESTIC_PASSWORD_FILE=/etc/demand/restic-password
BACKUP_HOST=REPLACE-approved-off-server-public-IPv4
BACKUP_USER=demand_backup
BACKUP_HOST_FINGERPRINT=REPLACE-independently-verified-SHA256-fingerprint
