# Install as /etc/portfolio/backup.env, root:root 0600. Separate from state credentials.
RESTIC_REPOSITORY=s3:https://REPLACE_WITH_BACKUP_ENDPOINT/REPLACE_WITH_DEDICATED_APP_BUCKET
RESTIC_PASSWORD_FILE=/etc/portfolio/restic.password
AWS_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_ONLY_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_ONLY_SECRET_KEY
AWS_DEFAULT_REGION=REPLACE_WITH_BACKUP_REGION
