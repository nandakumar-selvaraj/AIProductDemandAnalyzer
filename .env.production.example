# Copy to .env.production; chmod 600; never commit the real file.
COMPOSE_PROJECT_NAME=demand
APP_DOMAIN=demand.example.com
ACME_EMAIL=operator@example.com
POSTGRES_DB=demand
POSTGRES_USER=demand_owner
# Generate independent hexadecimal secrets (e.g. openssl rand -hex 32).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
OPERATOR_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Hex password avoids URL encoding ambiguity. Never reuse development credentials.
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
DATABASE_URL=postgresql+psycopg://demand_app:REPLACE_WITH_DIFFERENT_RANDOM_HEX@db:5432/demand
MIGRATION_DATABASE_URL=postgresql+psycopg://demand_owner:REPLACE_WITH_RANDOM_HEX@db:5432/demand
TRUSTED_HOSTS=["demand.example.com","127.0.0.1","backend"]
AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENT_REQUESTS=1
AI_REQUESTS_PER_MINUTE=6
AI_DAILY_REQUEST_CAP=50

# Public reads are opt-in and use an independently seeded *_demo database.
PUBLIC_DEMO_ENABLED=false
DEMO_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
DEMO_DATABASE_URL=
DEMO_AI_ENABLED=false
DEMO_READS_PER_MINUTE=120
DEMO_AI_REQUESTS_PER_MINUTE=3
DEMO_AI_DAILY_CAP=10
